# Backend API URL (REQUIRED)
# Local development: http://localhost:8000
# Production (nginx /backend prefix): http://35.154.241.94/backend
VITE_BACKEND_URL=http://localhost:8000

# Frontend URL (REQUIRED — used to construct the OAuth redirect URI)
# Must match a redirect URI registered on https://auth.devclub.in
# Local: http://localhost:5173  |  Prod: http://35.154.241.94
VITE_FRONTEND_URL=http://localhost:5173

# DevClub OAuth Client ID (REQUIRED) — same client as backend CLIENT_ID
# Register at https://auth.devclub.in/
VITE_DEVCLUB_CLIENT_ID=your_client_id_here

# DevClub OAuth base URL (Optional — login URL is built by the backend)
VITE_DEVCLUB_OAUTH_BASE_URL=https://auth.devclub.in

# Demo mode — bypasses authentication for presentations (Optional, default: false)
VITE_DEMO_MODE=false
