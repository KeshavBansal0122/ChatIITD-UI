# Backend API URL (REQUIRED)
# Local development: http://localhost:8000
# Docker / production: set to the public URL of the backend service
VITE_BACKEND_URL=http://localhost:8000

# Frontend URL (REQUIRED — used to construct the OAuth redirect URI)
# Must match the URL registered with DevClub OAuth
# Local: http://localhost:5173  |  Docker preview: http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173

# DevClub OAuth Client ID (REQUIRED)
# Register your application at https://oauth.devclub.in/
VITE_DEVCLUB_CLIENT_ID=your_client_id_here

# DevClub OAuth base URL (Optional — defaults to https://oauth.devclub.in)
VITE_DEVCLUB_OAUTH_BASE_URL=https://oauth.devclub.in

# Demo mode — bypasses authentication for presentations (Optional, default: false)
VITE_DEMO_MODE=false
